{
  "name": "Magic Mike Script Adherence - Isolated Pilot (no schedule)",
  "nodes": [
    {
      "id": "trigger",
      "name": "Pilot request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "script-adherence-pilot-SET-PRIVATE-PATH",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "au0Tm3M76yHHp84e",
          "name": "Magic Mike Script Adherence - Pilot transport"
        }
      }
    },
    {
      "id": "validate",
      "name": "Validate reserved pilot requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json.body?.requests;if(!Array.isArray(r)||!r.length||r.length>20)throw Error('Pilot limited to 20 reserved requests');const seen=new Set();for(const x of r){if(!/^[a-f0-9]{64}$/.test(x.id)||seen.has(x.id)||!['gpt-6-luna','claude-haiku-5-5'].includes(x.model)||typeof x.system!=='string'||typeof x.text!=='string'||Buffer.byteLength(x.text)>200000||Buffer.byteLength(x.system)>30000)throw Error('Invalid pilot request');seen.add(x.id);}return r.map(x=>({json:x}));"
      }
    },
    {
      "id": "oa-select",
      "name": "Luna requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -120
      ],
      "parameters": {
        "jsCode": "return $input.all().filter(x=>x.json.model==='gpt-6-luna').map(x=>({json:{...x.json,body:{model:'gpt-6-luna',messages:[{role:'system',content:x.json.system},{role:'user',content:x.json.text}],max_completion_tokens:10000,reasoning_effort:'low',response_format:{type:'json_object'}}}}));"
      }
    },
    {
      "id": "an-select",
      "name": "Haiku requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        120
      ],
      "parameters": {
        "jsCode": "return $input.all().filter(x=>x.json.model==='claude-haiku-5-5').map(x=>({json:{...x.json,body:{model:'claude-haiku-5-5',max_tokens:10000,output_config:{effort:'low'},system:[{type:'text',text:x.json.system,cache_control:{type:'ephemeral'}}],messages:[{role:'user',content:x.json.text}]}}}));"
      }
    },
    {
      "id": "oa",
      "name": "Luna analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        720,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 180000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 100
            }
          }
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "kaytW2ogFtybfuuw",
          "name": "Magic Mike Script Adherence - OpenAI - Moonis"
        }
      }
    },
    {
      "id": "an",
      "name": "Haiku analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        720,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 180000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 100
            }
          }
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "zw2mhXvaRZZLPtDn",
          "name": "Sales call analyzer"
        }
      }
    },
    {
      "id": "oa-pack",
      "name": "Luna receipts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -120
      ],
      "parameters": {
        "jsCode": "return $input.all().map((x,i)=>({json:{id:$('Luna requests').all()[i].json.id,response:x.json}}));"
      }
    },
    {
      "id": "an-pack",
      "name": "Haiku receipts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        120
      ],
      "parameters": {
        "jsCode": "return $input.all().map((x,i)=>({json:{id:$('Haiku requests').all()[i].json.id,response:x.json}}));"
      }
    },
    {
      "id": "merge",
      "name": "Merge receipts",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      }
    },
    {
      "id": "result",
      "name": "Pilot receipts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{results:$input.all().map(x=>x.json)}}];"
      }
    }
  ],
