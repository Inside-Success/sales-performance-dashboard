    {
      "type": "addNode",
      "node": {
        "id": "select-due-recovery",
        "name": "Select Due Recovery",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          350,
          -100
        ],
        "parameters": {
          "jsCode": "// Shared source-level retry policy. Business-write uncertainty must remain held.\nfunction retryable(message) {\n  return /timeout|timed out|aborted|524|429|50[0234]|529|overload|rate.?limit|temporar|ECONNRESET|ETIMEDOUT|fetch failed|socket|JSON parse|invalid structured|checkpoint (deferred|unavailable)/i.test(message);\n}\nfunction queueFailure(sourceId, executionId, message, attempt=0, now=Date.now()) {\n  if (!/^rec[A-Za-z0-9]+$/.test(sourceId)) throw Error(\"Invalid recovery source\");\n  const eligible=retryable(message);\n  const delay=attempt>=3?86400000:[300000,900000,3600000][Math.max(0,attempt)];\n  return {source_id:sourceId,execution_id:String(executionId),updated_at:new Date(now).toISOString(),report_id:\"\",\n    status:eligible?\"queued\":\"needs_review\",attempts:attempt,\n    message:(eligible?`retry_at=${new Date(now+delay).toISOString()} | `:\"\")+String(message).slice(0,900)};\n}\nfunction dueCalls(rows, now=Date.now()) {\n  return rows.filter(r=>r.status===\"queued\" && /^rec[A-Za-z0-9]+$/.test(r.source_id||\"\"))\n    .filter(r=>{const match=String(r.message||\"\").match(/^retry_at=([^ |]+)/);return !match || Date.parse(match[1])<=now;})\n    .sort((a,b)=>Date.parse(a.updated_at)-Date.parse(b.updated_at)).slice(0,1);\n}\n\nconst items=$input.all();return dueCalls(items.map(x=>x.json)).map(row=>({json:row,pairedItem:{item:items.findIndex(x=>x.json.id===row.id)}}));"
        }
      }
    },
    {
      "type": "rewireConnection",
      "source": "Read Queued Call",
      "from": "Claim Queued Call",
      "to": "Select Due Recovery"
    },
    {
      "type": "addConnection",
