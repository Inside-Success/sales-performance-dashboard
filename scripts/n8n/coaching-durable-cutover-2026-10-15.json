    {
      "type": "patchNodeField",
      "nodeName": "MM Build Classifier Request",
      "fieldPath": "parameters.jsCode",
      "patches": [
        {
          "find": "return { json: { state, provider_request: providerBody(CUTOVER.classifier, withLiveContext(CUTOVER.prompts.classifier), buildTranscriptPrompt(caseItem), state, \"classifier\") } };",
          "replace": "const provider_request=providerBody(CUTOVER.classifier, withLiveContext(CUTOVER.prompts.classifier), buildTranscriptPrompt(caseItem), state, \"classifier\");\nprovider_request.output_config={...(provider_request.output_config||{}),format:{\"type\":\"json_schema\",\"schema\":{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"call_status\":{\"type\":\"string\",\"enum\":[\"scored\",\"rep_no_show\",\"prospect_no_show\",\"transcript_too_short\"]},\"classification_reason\":{\"type\":\"string\"},\"evidence_quote\":{\"type\":\"string\"},\"confidence\":{\"type\":\"string\",\"enum\":[\"high\",\"medium\",\"low\"]}},\"required\":[\"call_status\",\"classification_reason\",\"evidence_quote\",\"confidence\"]}}};\nreturn {json:{state,provider_request}};"
        }
      ]
    },
    {
      "type": "updateNode",
      "nodeName": "MM Queue Unfinished Coaching",
      "updates": {
        "parameters.jsCode": "// Shared source-level retry policy. Business-write uncertainty must remain held.\nfunction retryable(message) {\n  if (/\\b401\\b|\\b403\\b|\\brefusal\\b|invalid source/i.test(message)) return false;\n  return /timeout|timed out|aborted|524|429|50[0234]|529|overload|rate.?limit|temporar|ECONNRESET|ETIMEDOUT|EAI_AGAIN|fetch failed|socket|connection.*closed|empty response|JSON parse|invalid structured|checkpoint (deferred|unavailable)/i.test(message);\n}\nfunction queueFailure(sourceId, executionId, message, attempt=0, now=Date.now()) {\n  if (!/^rec[A-Za-z0-9]+$/.test(sourceId)) throw Error(\"Invalid recovery source\");\n  const eligible=retryable(message);\n  const delay=attempt>=3?86400000:[300000,900000,3600000][Math.max(0,attempt)];\n  return {source_id:sourceId,execution_id:String(executionId),updated_at:new Date(now).toISOString(),report_id:\"\",\n    status:eligible?\"queued\":\"needs_review\",attempts:attempt,\n    message:(eligible?`retry_at=${new Date(now+delay).toISOString()} | `:\"\")+String(message).slice(0,900)};\n}\nfunction dueCalls(rows, now=Date.now()) {\n  return rows.filter(r=>r.status===\"queued\" && /^rec[A-Za-z0-9]+$/.test(r.source_id||\"\"))\n    .filter(r=>{const match=String(r.message||\"\").match(/^retry_at=([^ |]+)/);return !match || Date.parse(match[1])<=now;})\n    .sort((a,b)=>Date.parse(a.updated_at)-Date.parse(b.updated_at)).slice(0,1);\n}\n\nconst recovery=$('MM Recovery Entry').isExecuted;\nconst attempt=recovery?Number($('MM Recovery Entry').first().json.recovery_attempt||1):0;\nreturn {json:queueFailure(String($('If').item.json['Source Airtable Record ID']||''),$execution.id,String($json.error_details||$json.error?.message||$json.message||'Coaching failed'),attempt)};"
      }
    },
    {
      "type": "updateNode",
      "nodeName": "MM Recovery Entry",
      "updates": {
        "parameters.workflowInputs.values": [
          {
            "name": "source_id",
            "type": "string"
          },
          {
            "name": "recovery_attempt",
            "type": "number"
          }
        ]
      }
    },
    {
      "type": "patchNodeField",
      "nodeName": "Set: agent_failed",
      "fieldPath": "parameters.assignments.assignments.2.value",
      "patches": [
        {
          "find": "={{ 'AI grading pipeline failed. Failed stage: ' + String($json.stage || $json.failed_stage || $json.node || 'Classifier/Coaching/Compliance/Translator') + ' | Execution ID: ' + $execution.id + ' | Error: ' + String($json.error || $json.message || 'See execution logs').slice(0, 300) + ' | Transcript chars: ' + String($json.cleaned_transcript || $('If').item.json.cleaned_transcript || '').length + ' | Meeting ID: ' + ($('If').item.json['Meeting ID'] || '') + ' | Source Record: ' + ($('If').item.json['Source Airtable Record ID'] || '') }}",
          "replace": "={{ 'AI grading pipeline failed. Failed stage: ' + String($json.stage || $json.failed_stage || $json.node || 'Classifier/Coaching/Compliance/Translator') + ' | Execution ID: ' + $execution.id + ' | Error: ' + String($json.error?.message || $json.message || (typeof $json.error === 'object' ? JSON.stringify($json.error) : $json.error) || 'See execution logs').slice(0, 300) + ' | Transcript chars: ' + String($json.cleaned_transcript || $('If').item.json.cleaned_transcript || '').length + ' | Meeting ID: ' + ($('If').item.json['Meeting ID'] || '') + ' | Source Record: ' + ($('If').item.json['Source Airtable Record ID'] || '') }}"
        }
      ]
    },
