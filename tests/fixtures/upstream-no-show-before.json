    {
      "id": "mm-account-early-outcome",
      "name": "MM Account Early Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "continueErrorOutput",
      "position": [
        11800,
        9100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function accountEarlyOutcome(row, input, executionId, attempts=0) {\n  const sourceId=row?.['Source Airtable Record ID'];\n  if(!/^rec[A-Za-z0-9]+$/.test(sourceId||'')) throw Error('Accounting source identity missing; no receipt written');\n  const raw=input.call_status;\n  const status=raw==='call_1_skipped'?'call_1':raw;\n  if(!['call_1','transcript_too_short'].includes(status)) throw Error('Unexpected early outcome; no exclusion written');\n  const gate=input._mm_classifier_gate?JSON.parse(input._mm_classifier_gate):null;\n  if(gate && (gate.call_status!==status || !gate.classification_reason)) throw Error('Classifier/terminal outcome mismatch');\n  return {source_id:sourceId,status:status==='call_1'?'excluded':'needs_review',execution_id:String(executionId),\n    updated_at:new Date().toISOString(),attempts,report_id:'',message:JSON.stringify({\n      revision:gate?.guard_revision||'accounting-containment-2026-10-19',status,\n      raw_status:raw,reason:gate?.classification_reason||input.skip_reason||'Empty transcript; inspect source before retry',\n      original_status:gate?.classifier_original_status,original_reason:gate?.classifier_original_reason})};\n}\nreturn {json:accountEarlyOutcome($('Loop Over Items').item.json,$json,$execution.id,$('MM Recovery Entry').isExecuted?Number($('MM Recovery Entry').first().json.recovery_attempt||1):0),pairedItem:{item:0}};"
      }
    }
  ],
